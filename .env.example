# Copy to .env and set your local database password before starting Compose.
POSTGRES_PASSWORD=

# Optional host port for PostgreSQL.
POSTGRES_PORT=5432

# Prisma a separate, initially empty development database.
# Set your URL-encoded local password between ':' and '@' in .env only.
# Never point the first migration at the manually initialized trading_orders DB.
DATABASE_URL=postgresql://trading:@127.0.0.1:5432/trading_orders_prisma_dev
