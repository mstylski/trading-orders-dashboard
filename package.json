{
  "name": "trading-orders-dashboard",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "format": "prettier --write src api db/tests prisma.config.ts",
    "format:check": "prettier --check src api db/tests prisma.config.ts",
    "lint": "ng lint && npm run lint:api && npm run lint:db",
    "lint:api": "eslint api prisma.config.ts",
    "lint:db": "eslint db/tests",
    "serve:ssr:trading-orders-dashboard": "node dist/trading-orders-dashboard/server/server.mjs",
    "build:api": "prisma generate && tsc -p api/tsconfig.json && node api/scripts/copy-data.mjs",
    "start:api": "npm run build:api && node dist/api/main.js",
    "test:api": "npm run build:api && node --test --test-concurrency=1 api/test/*.test.mjs",
    "test:db": "node db/tests/run.mjs",
    "test:db:fixtures": "node db/tests/check-fixtures.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:verify": "tsx api/prisma/verify.ts",
    "db:typecheck": "tsc -p api/prisma/tsconfig.json"
  },
  "private": true,
  "packageManager": "npm@11.17.0",
  "dependencies": {
    "@angular/common": "22.2.1",
    "@angular/compiler": "22.2.1",
    "@angular/core": "22.2.1",
    "@angular/forms": "22.2.1",
    "@angular/platform-browser": "22.2.1",
    "@angular/platform-server": "22.2.1",
    "@angular/router": "22.2.1",
    "@angular/ssr": "^22.2.1",
    "@nestjs/common": "^11.2.8",
    "@nestjs/core": "^11.2.8",
    "@nestjs/platform-express": "^11.2.8",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "dotenv": "18.0.10",
    "express": "^5.1.0",
    "pg": "8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "22.2.1",
    "@angular/cli": "22.2.1",
    "@angular/compiler-cli": "22.2.1",
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.1",
    "@types/node": "^22.12.0",
    "@types/pg": "8.23.1",
    "angular-eslint": "22.6.0",
    "eslint": "^10.12.0",
    "jsdom": "^30.0.0",
    "lossless-json": "4.3.3",
    "prettier": "^3.8.1",
    "prisma": "7.10.1",
    "tsx": "4.23.15",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.71.0",
    "vitest": "^5.0.0"
  }
}
